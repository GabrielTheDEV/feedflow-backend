# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
USE_SUPABASE=true


DATABASE_URL=postgresql://postgres.<your-project-id>:<your_postgres_password>@<your_postgres_host>:<port>/<your_database_name>

# Slack
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=https://your-tunnel-domain.cfargotunnel.com/integrations/oauth/callback
BOT_TOKEN=your_slack_bot_token_here



# OAuth state signing secret (HMAC-SHA256) — gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=your_random_secret_here

# Cloudflare Tunnel (for OAuth HTTPS tunnel)
# Crie em: https://dash.teams.cloudflare.com → Networks → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiNGQwOWFkYjIxZTY0NTQ5MjRjZTZjNzZmNWU2ODgzZjUiLCJ0IjoiYjMxMTgzNWYtYTVmNC00YTZhLWEyZTUtMzUxYjU1ODYyNmNkIiwicyI6IlpqaGtNbUV4Tm1NdE5tRTBaQzAwTjJKakxXSmxOR0l0WlRSa01HTTFaREUyWkdFMiJ9


# Google Generative AI (Gemini) para análise de bugs
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here
