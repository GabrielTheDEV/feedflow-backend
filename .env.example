# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
USE_SUPABASE=true

# Slack
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.app/integrations/oauth/callback

# OAuth state signing secret (HMAC-SHA256) — gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=your_random_secret_here

# ngrok (for OAuth HTTPS tunnel)
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Google Generative AI (Gemini) para análise de bugs
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here
